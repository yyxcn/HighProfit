{
  "name": "highprofit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @highprofit/web",
    "build": "npm run build --workspace @highprofit/core && npm run build --workspace @highprofit/web",
